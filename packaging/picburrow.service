[Unit]
Description=Picburrow photo gallery
Documentation=https://github.com/oPercentOps/Picburrow
# photo folders are often network or USB mounts
After=network-online.target local-fs.target remote-fs.target
Wants=network-online.target

[Service]
User=picburrow
Group=picburrow
# PICBURROW_DATA and PICBURROW_LISTEN can be changed in /etc/default/picburrow
EnvironmentFile=-/etc/default/picburrow
ExecStart=/usr/bin/picburrow
StateDirectory=picburrow
Restart=on-failure
RestartSec=5
# Picburrow reads photo folders and writes its own data dir; it writes to a photo folder only for photos sent with an
# API key (/api/assets/upload), and only where the picburrow user may write. ProtectHome keeps /home read-only: to
# receive photos into a folder under /home, add ReadWritePaths=<that folder> with sudo systemctl edit picburrow.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

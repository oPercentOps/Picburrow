[Unit]
Description=Picburrow photo gallery
Documentation=https://github.com/oPercentOps/Picburrow
# photo folders are often network or USB mounts
After=network-online.target local-fs.target remote-fs.target
Wants=network-online.target

[Service]
User=picburrow
Group=picburrow
# PICBURROW_DATA and PICBURROW_LISTEN can be changed in /etc/default/picburrow
EnvironmentFile=-/etc/default/picburrow
ExecStart=/usr/bin/picburrow
StateDirectory=picburrow
Restart=on-failure
RestartSec=5
# Picburrow only reads photo folders; it writes nothing but its own data dir.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

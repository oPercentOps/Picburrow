# Settings for the Picburrow service. Restart after changing: sudo systemctl restart picburrow
#
# Where the database and previews live. Put this on a USB SSD or hard drive rather than the SD card,
# and give the picburrow user write access to it: sudo chown picburrow: /mnt/ssd/picburrow
#PICBURROW_DATA=/var/lib/picburrow
#
# Address to serve on.
#PICBURROW_LISTEN=:8080
#
# 0 = stop converting videos for smooth playback (hours of CPU on a Pi 3). Copies already made keep being used.
#PICBURROW_VIDEO_COPIES=1

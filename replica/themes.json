{
  "_about": "Themes for self-hosted photo galleries (Immich, PhotoPrism), on top of the generic ones. Patterns are case-insensitive regexes.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
  ],
  "themes": [
    {
      "id": "pricing",
      "label": "Price and paywalls",
      "kind": "complaint",
      "patterns": [
        "\\bexpensive\\b",
        "\\boverpriced\\b",
        "\\bpric(e|es|ey|ing)\\b",
        "\\bpaywall",
        "\\bsubscription\\b",
        "\\bper (month|seat|user)\\b",
        "\\bfree (plan|tier|version)\\b",
        "\\bupgrade to\\b",
        "\\bpremium\\b",
        "\\bnot worth\\b",
        "\\bcost(s|ly)?\\b"
      ]
    },
    {
      "id": "bugs",
      "label": "Bugs and crashes",
      "kind": "complaint",
      "patterns": [
        "\\bcrash(es|ed|ing)?\\b",
        "\\bbugs?\\b",
        "\\bbuggy\\b",
        "\\bglitch",
        "\\bfreez(e|es|ing)\\b",
        "\\bbroken\\b",
        "\\b(doesn'?t|does not|stopped) work",
        "\\bnot working\\b",
        "\\berror\\b"
      ]
    },
    {
      "id": "performance",
      "label": "Slow, laggy, heavy",
      "kind": "complaint",
      "patterns": [
        "\\bslow\\b",
        "\\blag(gy|s)?\\b",
        "\\bloading\\b",
        "\\btakes forever\\b",
        "\\bbattery\\b",
        "\\bsluggish\\b",
        "\\bheavy\\b"
      ]
    },
    {
      "id": "data",
      "label": "Sync and lost data",
      "kind": "complaint",
      "patterns": [
        "\\bsync(ing|s|ed)?\\b",
        "\\blost (my|all)\\b",
        "\\bdisappear",
        "\\bdata loss\\b",
        "\\bwiped\\b",
        "\\bbackup\\b",
        "\\bduplicat"
      ]
    },
    {
      "id": "ux",
      "label": "Confusing or clunky to use",
      "kind": "complaint",
      "patterns": [
        "\\bconfus",
        "\\bhard to (use|find|navigate|understand)\\b",
        "\\bcomplicated\\b",
        "\\bcluttered\\b",
        "\\bunintuitive\\b",
        "\\bnot intuitive\\b",
        "\\bclunky\\b",
        "\\btoo many (steps|clicks|taps)\\b",
        "\\blearning curve\\b",
        "\\bcan'?t find\\b"
      ]
    },
    {
      "id": "account",
      "label": "Login and account problems",
      "kind": "complaint",
      "patterns": [
        "\\blog ?in\\b",
        "\\bsign ?in\\b",
        "\\bpassword\\b",
        "\\blocked out\\b",
        "\\bverification\\b",
        "\\b2fa\\b",
        "\\bdelete (my )?account\\b"
      ]
    },
    {
      "id": "updates",
      "label": "A redesign or update made it worse",
      "kind": "complaint",
      "patterns": [
        "\\b(new|latest|recent) (update|version|design)\\b",
        "\\bredesign",
        "\\bused to be\\b",
        "\\bbring back\\b",
        "\\bsince the update\\b"
      ]
    },
    {
      "id": "privacy",
      "label": "Privacy and permissions",
      "kind": "complaint",
      "patterns": [
        "\\bprivacy\\b",
        "\\btracking\\b",
        "\\bsell(s|ing)? (my )?data\\b",
        "\\bpermissions?\\b",
        "\\bcreepy\\b"
      ]
    },
    {
      "id": "integrations",
      "label": "Integrations, import and export",
      "kind": "request",
      "patterns": [
        "\\bintegrat",
        "\\bzapier\\b",
        "\\bgoogle (calendar|sheets|drive)\\b",
        "\\boutlook\\b",
        "\\bslack\\b",
        "\\bapi\\b",
        "\\bexport\\b",
        "\\bimport\\b",
        "\\bcsv\\b",
        "\\bwebhook"
      ]
    },
    {
      "id": "platforms",
      "label": "Platforms, offline and mobile",
      "kind": "request",
      "patterns": [
        "\\boffline\\b",
        "\\bandroid\\b",
        "\\bipad\\b",
        "\\btablet\\b",
        "\\bdesktop app\\b",
        "\\bmac app\\b",
        "\\bwindows\\b",
        "\\bmobile (app|version)\\b",
        "\\bweb version\\b"
      ]
    },
    {
      "id": "collaboration",
      "label": "Teams and sharing",
      "kind": "request",
      "patterns": [
        "\\bteam(s|mates?)?\\b",
        "\\bshar(e|ing)\\b",
        "\\bcollaborat",
        "\\bmultiple (users|accounts|people)\\b",
        "\\broles?\\b",
        "\\bpermissions for\\b"
      ]
    },
    {
      "id": "resources",
      "label": "Too heavy: RAM, CPU, hardware",
      "kind": "complaint",
      "patterns": [
        "\\bram\\b",
        "\\bmemory\\b",
        "\\bcpu\\b",
        "\\bresource",
        "\\b\\d+ ?gb\\b",
        "\\braspberry\\b",
        "\\b(pi|rpi) ?[345]\\b",
        "\\bnas\\b",
        "\\bheavy\\b",
        "\\bbloat",
        "\\bresource.?hungry\\b",
        "\\boverkill\\b"
      ]
    },
    {
      "id": "docker",
      "label": "Install and Docker/Postgres complexity",
      "kind": "complaint",
      "patterns": [
        "\\bdocker\\b",
        "\\bcompose\\b",
        "\\bpostgres",
        "\\bcontainers?\\b",
        "\\binstall",
        "\\bsetup\\b",
        "\\bset up\\b",
        "\\bkubernetes\\b",
        "\\bportainer\\b",
        "\\bmicroservices?\\b",
        "\\bredis\\b"
      ]
    },
    {
      "id": "breaking",
      "label": "Breaking changes and risky upgrades",
      "kind": "complaint",
      "patterns": [
        "\\bbreaking change",
        "\\bbreaks?\\b",
        "\\bupgrad",
        "\\bmigrat",
        "\\brelease notes\\b",
        "\\bunstable\\b",
        "\\bbeta\\b",
        "\\bnot (yet )?stable\\b",
        "\\bdon'?t use (it )?as (your|a) (only|primary)",
        "\\bproduction.?ready\\b"
      ]
    },
    {
      "id": "files",
      "label": "Doesn't respect my existing folders / files",
      "kind": "complaint",
      "patterns": [
        "\\bfolder",
        "\\bdirector(y|ies)\\b",
        "\\bfile ?system\\b",
        "\\bexternal librar",
        "\\bstorage template\\b",
        "\\bread.?only\\b",
        "\\bmov(e|ed|ing) (my )?files\\b",
        "\\bown structure\\b",
        "\\bimport (my|existing)\\b",
        "\\bsidecar",
        "\\bxmp\\b",
        "\\bmetadata\\b"
      ]
    },
    {
      "id": "ml",
      "label": "Faces, ML and smart search",
      "kind": "request",
      "patterns": [
        "\\bface",
        "\\bfacial\\b",
        "\\bmachine learning\\b",
        "\\b(ml|ai)\\b",
        "\\bclip\\b",
        "\\bsmart search\\b",
        "\\bobject (detection|recognition)\\b",
        "\\bsemantic\\b"
      ]
    },
    {
      "id": "mobile",
      "label": "Phone backup and mobile apps",
      "kind": "request",
      "patterns": [
        "\\bbackup\\b",
        "\\bauto.?upload",
        "\\bphone\\b",
        "\\biphone\\b",
        "\\bandroid\\b",
        "\\bmobile app\\b",
        "\\bios\\b",
        "\\bsyncthing\\b"
      ]
    },
    {
      "id": "gphotos",
      "label": "Leaving Google Photos / iCloud",
      "kind": "request",
      "patterns": [
        "\\bgoogle photos\\b",
        "\\bicloud\\b",
        "\\btakeout\\b",
        "\\bapple photos\\b",
        "\\breplace(ment)? for\\b",
        "\\balternative to\\b"
      ]
    },
    {
      "id": "license",
      "label": "Paid tiers and licence",
      "kind": "complaint",
      "patterns": [
        "\\bmembership\\b",
        "\\bplus\\b",
        "\\bsupporter\\b",
        "\\blicen[cs]e",
        "\\bagpl\\b",
        "\\bopen.?core\\b",
        "\\bpaid (features|tier|version)\\b"
      ]
    }
  ]
}